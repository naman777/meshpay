# Server-only PostgreSQL URI. Use your provider's pooled URI on Vercel.
# Never prefix this variable with NEXT_PUBLIC_. Keep real credentials out of Git.
DATABASE_URL=
# Dedicated schema, isolated from other applications in the same database.
DATABASE_SCHEMA=meshpay
# Aiven/private CA: paste its trusted PEM certificate here (quoted with \n escapes).
DATABASE_CA_CERT=
# Explicit opt-out for a provider connection without its CA (encrypted, unverified TLS).
# Prefer the provider CA with verification enabled when available.
DATABASE_TLS_VERIFY=true
# Optional integration test connection; tests create and remove an isolated schema.
POSTGRES_TEST_URL=
